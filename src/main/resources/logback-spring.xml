<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- AWS (ECS Fargate): all output to stdout; awslogs driver ships it to CloudWatch -->
    <springProfile name="aws-dev,aws-staging,prod">
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z'}{UTC} %-5level [%thread] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        <logger name="com.moipay.splitengine" level="INFO"/>
        <root level="INFO">
            <appender-ref ref="STDOUT"/>
        </root>
    </springProfile>

    <!-- Local development: human-friendly format with DEBUG for app code -->
    <springProfile name="!aws-dev &amp; !aws-staging &amp; !prod">
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        <logger name="com.moipay.splitengine" level="DEBUG"/>
        <root level="INFO">
            <appender-ref ref="STDOUT"/>
        </root>
    </springProfile>

</configuration>
